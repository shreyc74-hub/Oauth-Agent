# Required for the agent (research, chat and vendor lookup)
ANTHROPIC_API_KEY=

# Supabase storage, server-side only. Without these, generated guides and corrections live in memory
# and disappear on redeploy. Use the project URL and a secret key (sb_secret_...) or the legacy service_role key.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Optional: models (defaults shown)
GUIDE_MODEL=claude-sonnet-5-5
# RESOLVE_MODEL=   # model for vendor lookup and the self-check review; defaults to GUIDE_MODEL

# Optional: reading pages that need JavaScript. jina (default, no key needed), browserless, or off
RENDER_PROVIDER=jina
# JINA_API_KEY=        # raises the jina reader's rate limits
# BROWSERLESS_TOKEN=   # required when RENDER_PROVIDER=browserless

# Optional: per-network limits per hour
GENERATE_LIMIT_PER_HOUR=6
CHAT_LIMIT_PER_HOUR=40
RESOLVE_LIMIT_PER_HOUR=40

# Testing without an API key: AGENT_MOCK=1 replays a library guide and canned chat answers.
# AGENT_MOCK_FAST=1 removes the replay delays (used by the tests).
AGENT_MOCK=

# Optional: get a notification whenever someone uses the agent (research, saves, chat).
# ntfy (phone push, no account): https://ntfy.sh/<long-random-topic>, or a Slack or Discord webhook URL.
NOTIFY_URL=

# ---------- Provisioning agent (/provision) ----------
# Demo without any accounts: simulated browser, inbox and provider APIs. Everything else is real.
PROVISION_MOCK=
# Required for real runs on a deployment: people must enter this code to start or drive a run.
PROVISION_ACCESS_CODE=
# Required to reveal a stored secret in the UI. Every reveal is logged on the run.
PROVISION_ADMIN_TOKEN=
# Public URL of this site; the redirect URI for every app the agent creates is <this>/api/oauth/callback.
PUBLIC_BASE_URL=
# Hosted browser (Browserbase). Captcha solving is switched off on purpose.
BROWSERBASE_API_KEY=
BROWSERBASE_PROJECT_ID=
# STAGEHAND_MODEL=anthropic/claude-sonnet-5-5
# Agent inboxes for full automation (sign-up emails, OTP codes, magic links).
AGENTMAIL_API_KEY=
# Tracker sheet: a Google service account JSON (one line) and the sheet ID. Share the sheet with the
# service account's email as Editor. Rows hold status, masked client ID and vault names, never secrets.
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_SHEET_ID=
# GOOGLE_SHEET_TAB=Credentials
# Local only, when Supabase isn't configured: key for the in-memory secret store.
# PROVISION_SECRET_KEY=
