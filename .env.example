# Required for the research agent
ANTHROPIC_API_KEY=
# Optional: Supabase storage (server-side only). Without these, generated guides live in memory.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Optional
GUIDE_MODEL=claude-sonnet-5-5
GENERATE_LIMIT_PER_HOUR=6
# Set to 1 to replay a library guide through the UI without an API key
AGENT_MOCK=
