# Required for the agent (research, chat and vendor lookup)
ANTHROPIC_API_KEY=

# Supabase storage, server-side only. Without these, generated guides and corrections live in memory
# and disappear on redeploy. Use the project URL and a secret key (sb_secret_...) or the legacy service_role key.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Optional: models (defaults shown)
GUIDE_MODEL=claude-sonnet-5-5
# RESOLVE_MODEL=   # model for vendor lookup and the self-check review; defaults to GUIDE_MODEL

# Optional: reading pages that need JavaScript. jina (default, no key needed), browserless, or off
RENDER_PROVIDER=jina
# JINA_API_KEY=        # raises the jina reader's rate limits
# BROWSERLESS_TOKEN=   # required when RENDER_PROVIDER=browserless

# Optional: per-network limits per hour
GENERATE_LIMIT_PER_HOUR=6
CHAT_LIMIT_PER_HOUR=40
RESOLVE_LIMIT_PER_HOUR=40

# Testing without an API key: AGENT_MOCK=1 replays a library guide and canned chat answers.
# AGENT_MOCK_FAST=1 removes the replay delays (used by the tests).
AGENT_MOCK=
