{
  "name": "oauth-readiness-guides",
  "version": "1.0.0",
  "private": true,
  "description": "OAuth app readiness guides for agent builders on Composio, with a live research agent.",
  "scripts": {
    "bundle": "tsx scripts/bundle-content.ts",
    "predev": "tsx scripts/bundle-content.ts",
    "dev": "next dev",
    "prebuild": "tsx scripts/bundle-content.ts",
    "build": "next build",
    "start": "next start",
    "validate": "tsx scripts/validate.ts",
    "pretest": "tsx scripts/bundle-content.ts",
    "test": "tsx --tsconfig tsconfig.scripts.json --test tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "seed:sql": "tsx scripts/seed-sql.ts > supabase/seed.sql",
    "build:artifact": "tsx --tsconfig tsconfig.scripts.json scripts/build-artifact.ts",
    "e2e": "node scripts/e2e.cjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.117.2",
    "next": "16.4.1",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/node": "20.14.10",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "tsx": "4.16.2",
    "typescript": "5.5.3"
  }
}
